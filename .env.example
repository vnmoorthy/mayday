# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, test mode. Run `node scripts/stripe-setup.mjs` to create the meter and price.
# Without these the app runs in demo billing mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_METER_EVENT_NAME=pioneer_rescue
STRIPE_WEBHOOK_SECRET=

# Gemini: drafts official fixes and flies the live flights on /live.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Vercel AI Gateway, used for drafted fixes when no Gemini key is set.
AI_GATEWAY_API_KEY=

# Optional: when set, /api/stripe/reconcile requires "Authorization: Bearer <value>"
# (Vercel Cron sends it automatically).
CRON_SECRET=

# Public URL of this deployment (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
