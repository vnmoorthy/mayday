# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe, test mode. Run `node scripts/stripe-setup.mjs` to create the meter and price.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_METER_EVENT_NAME=mayday_rescue
STRIPE_WEBHOOK_SECRET=

# Public URL of this deployment (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Vercel AI Gateway key, used by hosted test flights
AI_GATEWAY_API_KEY=
